# Copier ce fichier en .env.local pour tester en local (ce fichier-là n'est jamais envoyé sur GitHub).
# En production, ces variables se définissent dans le tableau de bord de l'hébergeur
# (Vercel : Settings → Environment Variables ; Netlify : Site configuration → Environment variables).

# URL publique du site (canonical, og:url, sitemap)
NEXT_PUBLIC_SITE_URL=https://fofoitech.com

# --- Envoi des emails du formulaire de contact (SMTP) ---
# Boîte mail qui envoie les demandes, et son mot de passe  (OBLIGATOIRES)
SMTP_USER=contact@fofoitech.com
SMTP_PASS=

# Facultatives : les valeurs par défaut conviennent à la messagerie LWS de fofoitech.com
# SMTP_HOST=mail.fofoitech.com
# SMTP_PORT=465
# SMTP_TLS_SERVERNAME=mail.lwspanel.com
# CONTACT_TO_EMAILS=directeur@fofoitech.com,contact@fofoitech.com
